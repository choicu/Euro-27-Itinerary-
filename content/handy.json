    },
    {
      "label": "Smartraveller 24-hour Consular Emergency Centre (Canberra)",
      "value": "1300 555 135 (within Australia) / +61 2 6261 3305 (from overseas) — for Australians with serious/urgent needs abroad",
      "source": "https://www.smartraveller.gov.au/i-need-urgent-help",
      "verified": "2026-10-03"
    },
    {
      "label": "Australian Embassy, Rome (Italy)",
      "value": "Via Antonio Bosio 5, 00161 Rome. Tel +39 06 8527 21 (Mon–Fri, by appointment for passport/consular). Also covers Milan Consulate-General: +39 02 7767 4200",
      "source": "https://italy.embassy.gov.au/rome/769.html",
      "verified": "2026-10-03"
    },
    {
      "label": "Australian Embassy, Athens (Greece)",
      "value": "Level 2, 5 Hatziyianni Mexi Street, Athens 11528. Tel +30 210 870 4000 (Mon–Fri 08:00–16:00)",
      "source": "https://greece.embassy.gov.au/athn/contact-us.html",
      "verified": "2026-10-03"
    },
    {
      "label": "Australian Embassy, Brussels (Belgium)",
