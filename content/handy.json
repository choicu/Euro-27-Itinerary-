  "countries": {
    "Italy": {
      "currency": {
        "value": "Euro (EUR). ATMs are widely available; smaller towns and markets often prefer cash",
        "source": "https://www.smartraveller.gov.au/destinations/europe/italy",
        "verified": "2026-10-03"
      },
      "plug": {
        "value": "Type C, F and L sockets, 230V/50Hz. Most modern chargers (phone/laptop) are dual-voltage and only need a plug adapter",
        "source": "https://www.power-plugs-sockets.com/us/italy/",
        "verified": "2026-10-03"
      },
      "tipping": {
        "value": "Not expected — most restaurants already add a service charge (coperto/servizio) to the bill. If you do leave something extra, €1–2 per person rounded up in cash is plenty; there's no line to add a tip on a card receipt",
        "source": "https://community.ricksteves.com/travel-forum/italy/proper-tipping-etiquette-how-not-how-much",
        "verified": "2026-10-03"
      },
      "phrases": [
        { "en": "Hello", "local": "Ciao / Salve", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" },
        { "en": "Thank you", "local": "Grazie", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" },
        { "en": "Please", "local": "Per favore", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" },
        { "en": "The bill, please", "local": "Il conto, per favore", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" },
        { "en": "Where is...?", "local": "Dov'è...?", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" },
        { "en": "Do you speak English?", "local": "Parla inglese?", "source": "https://www.theintrepidguide.com/italian-phrases-for-travellers/", "verified": "2026-10-03" }
      ]
    },
    "Greece": {
      "currency": {
        "value": "Euro (EUR)",
        "source": "https://www.smartraveller.gov.au/destinations/europe/greece",
        "verified": "2026-10-03"
      },
      "plug": {
        "value": "Type C and F sockets, 230V/50Hz. Australian travellers need a plug adapter; most electronics are dual-voltage",
        "source": "https://esim.holafly.com/travel-tips/greece-plug-type/",
        "verified": "2026-10-03"
      },
      "tipping": {
        "value": "Not obligatory — staff are paid a wage regardless. Rounding up the bill or leaving 10–15% in tavernas is a common token of appreciation; closer to 20% (left as banknotes) at high-end restaurants",
        "source": "https://community.ricksteves.com/travel-forum/greece/how-to-tip-in-greece",
        "verified": "2026-10-03"
      },
      "phrases": [
        { "en": "Hello", "local": "Γεία σου / Γεία σας (ya sou / ya sas)", "source": "https://www.fluentin3months.com/greek-phrases/", "verified": "2026-10-03" },
        { "en": "Thank you", "local": "Ευχαριστώ (efharistó)", "source": "https://www.fluentin3months.com/greek-phrases/", "verified": "2026-10-03" },
        { "en": "Please", "local": "Παρακαλώ (parakaló)", "source": "https://www.fluentin3months.com/greek-phrases/", "verified": "2026-10-03" },
        { "en": "The bill, please", "local": "Τον λογαριασμό, παρακαλώ (ton logariasmó, parakaló)", "source": "https://greektriplanner.me/blog/greek-phrases", "verified": "2026-10-03" },
        { "en": "Where is...?", "local": "Πού είναι...; (pou íne...?)", "source": "https://www.fluentin3months.com/greek-phrases/", "verified": "2026-10-03" },
        { "en": "Do you speak English?", "local": "Μιλάτε αγγλικά; (miláte angliká?)", "source": "https://www.fluentin3months.com/greek-phrases/", "verified": "2026-10-03" }
      ]
    },
    "Belgium": {
      "currency": {
        "value": "Euro (EUR)",
        "source": "https://www.smartraveller.gov.au/destinations/europe/belgium",
        "verified": "2026-10-03"
      },
      "plug": {
        "value": "Type C and E sockets, 230V/50Hz. Australian travellers need a plug adapter",
        "source": "https://www.power-plugs-sockets.com/us/belgium/",
        "verified": "2026-10-03"
      },
      "tipping": {
        "value": "Not mandatory — service is included in prices. Rounding up or leaving ~10% for good service is appreciated, especially in Wallonia (French-speaking); less customary in Flanders (Dutch-speaking, where Tomorrowland/Boom is)",
        "source": "https://tippingin.com/en/how-much-to-tip-in-belgium",
        "verified": "2026-10-03"
      },
      "phrases": [
        { "en": "Hello (Dutch/Flemish — Boom/Antwerp area)", "local": "Hallo", "source": "https://www.omniglot.com/language/phrases/dutch.php", "verified": "2026-10-03" },
        { "en": "Thank you", "local": "Dank u wel (formal) / Dank je wel (informal)", "source": "https://www.omniglot.com/language/phrases/dutch.php", "verified": "2026-10-03" },
        { "en": "Please", "local": "Alstublieft (formal) / Alsjeblieft (informal)", "source": "https://www.omniglot.com/language/phrases/dutch.php", "verified": "2026-10-03" },
        { "en": "Where is...?", "local": "Waar is de WC? (example: where is the toilet)", "source": "https://www.omniglot.com/language/phrases/dutch.php", "verified": "2026-10-03" },
        { "en": "Do you speak English?", "local": "Spreekt u Engels? (formal) / Spreek je Engels? (informal)", "source": "https://www.omniglot.com/language/phrases/dutch.php", "verified": "2026-10-03" },
        { "en": "Hello (French — Brussels/Wallonia)", "local": "Bonjour", "source": "https://www.brussels.info/french-phrases/", "verified": "2026-10-03" },
        { "en": "The bill, please (French)", "local": "L'addition s'il vous plaît", "source": "https://www.brussels.info/french-phrases/", "verified": "2026-10-03" }
      ]
    },
